import { createClient } from "@supabase/supabase-js"

const url = process.env.NEXT_PUBLIC_SUPABASE_URL || "https://kngpwddyquxrcfydlxkg.supabase.co"
const key = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || process.env.SUPABASE_SERVICE_ROLE_KEY

const supabase = createClient(url, key)

export async function GET(req){
  try{
    const { searchParams } = new URL(req.url)
    let user_id = searchParams.get("user_id")

    // Auto-recognise: try both ids
    let idsToTry = [user_id, "user_123", "user"].filter(Boolean)

    for(let id of idsToTry){
      let { data } = await supabase.from("wallets").select("balance").eq("user_id", id).maybeSingle()
      if(data){
        return Response.json({ balance: data.balance, user_id: id, recognised: true })
      }
    }

    // If none found, create
    const newId = user_id || "user_123"
    await supabase.from("wallets").insert({ user_id: newId, balance: 10000 })
    return Response.json({ balance: 10000, user_id: newId, recognised: true })

  }catch(e){
    return Response.json({ error: e.message, balance: 0 }, { status: 500 })
  }
}
